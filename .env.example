# ============================================================
# Environment configuration — copy to .env and fill in values
# NEVER commit .env to source control
# ============================================================

# ---- Chain / RPC ----
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# ---- Signer keys (use a local Anvil test key in development only) ----
# In production, use a KMS/HSM reference, not a raw private key
DEPLOYER_PRIVATE_KEY=
BACKEND_SIGNER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=

# ---- Deployed contract addresses (filled after deployment) ----
TOKEN_ADDRESS=
IDENTITY_REGISTRY_ADDRESS=
COMPLIANCE_ADDRESS=
TRANSFER_AUTHORIZATION_ADDRESS=
ISSUANCE_MINTER_ADDRESS=

# ---- PostgreSQL (backend service) ----
DATABASE_URL=postgresql://rwa_user:CHANGEME@localhost:5432/rwa_platform

# ---- Backend service ----
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ---- Issuance / finality ----
CONFIRMATION_DEPTH=12
ISSUANCE_RETRY_DELAY_MS=5000
ISSUANCE_MAX_RETRIES=10
